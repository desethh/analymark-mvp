# Copy to .env.local. The local Ollama provider needs no API key.
AI_PROVIDER=ollama
AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_MS=180000
# Optional cloud provider: AI_PROVIDER=openai and OPENAI_ENABLED=true.
# Never commit credentials or put them in NEXT_PUBLIC_ variables.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local verification mail; no real mail is sent in this mode.
APP_ORIGIN=http://127.0.0.1:3000
MAIL_DELIVERY=local
# Temporarily disabled. Set true after email delivery is configured and tested.
REQUIRE_EMAIL_VERIFICATION=false
# Production uses MAIL_DELIVERY=resend, your verified sender and canonical HTTPS APP_ORIGIN.
MAIL_FROM=
RESEND_API_KEY=
