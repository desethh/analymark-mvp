# Copy to .env.local. Use your own OpenAI project key. Never commit it.
# Activate only after setting the key. Do not use NEXT_PUBLIC_ for credentials.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local verification mail; no real mail is sent in this mode.
APP_ORIGIN=http://127.0.0.1:3000
MAIL_DELIVERY=local
REQUIRE_EMAIL_VERIFICATION=true
# Production uses MAIL_DELIVERY=resend, your verified sender and canonical HTTPS APP_ORIGIN.
MAIL_FROM=
RESEND_API_KEY=
