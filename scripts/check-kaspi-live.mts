import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {normalizeKaspiUrl,cities} from '../src/lib/public-product.ts';
import {parseKaspiProduct} from '../src/lib/kaspi-parser.ts';
import {parsePublicPrices} from '../src/lib/public-prices.ts';
import {collectMarketPrices} from '../src/lib/market-prices.ts';
import {acquireKaspiSlot,readLimited} from '../src/lib/kaspi-http.ts';
const extra=process.argv.includes('--extra'),pagination=process.argv.includes('--pagination'),pageSize=pagination?2:20;
const samples=pagination?[{label:'Зарядное устройство · QA пагинации по 2 строки',url:'https://kaspi.kz/shop/p/apple-a2121-lightning-20-vt-belyi-149595086/'}]:extra?[{label:'iPhone 15 Dual SIM',url:'https://kaspi.kz/shop/p/apple-iphone-15-128-gb-dual-sim-chernyi-113933011/'},{label:'Чехол iPhone',url:'https://kaspi.kz/shop/p/dlja-apple-iphone-15-chernyi-130640327/'}]:[
 {label:'Зарядное устройство',url:'https://kaspi.kz/shop/p/apple-a2121-lightning-20-vt-belyi-149595086/'},
 {label:'Смартфон',url:'https://kaspi.kz/shop/p/samsung-galaxy-a16-4-gb-128-gb-serebristyi-131014726/'},
 {label:'Книга',url:'https://kaspi.kz/shop/p/dzheims-k-atomnye-privychki-166128998/'}];
const cases:unknown[]=[];let failures=0;
for(const sample of samples){const canonical=normalizeKaspiUrl(sample.url);for(const city of (extra||pagination?['Алматы']:['Алматы','Астана'])){const started=new Date().toISOString();try{
 await acquireKaspiSlot();const page=await fetch(canonical.url+'?c='+cities[city],{signal:AbortSignal.timeout(20000),redirect:'error',headers:{'User-Agent':'AnalyMarkMVP/0.1 (public product QA)','Accept':'text/html'}});if(!page.ok)throw Error('Product HTTP '+page.status);const product=parseKaspiProduct(await readLimited(page),canonical.url,city);assert.equal(product.productId,canonical.productId);assert.ok(product.name.length>3);
 let pages=0;const book=await collectMarketPrices({...canonical,city},async(index)=>{await acquireKaspiSlot();const response=await fetch('https://kaspi.kz/yml/offer-view/offers/'+canonical.productId,{method:'POST',redirect:'error',signal:AbortSignal.timeout(20000),headers:{'User-Agent':'AnalyMarkMVP/0.1 (public price QA)','Content-Type':'application/json','Accept':'application/json','Referer':canonical.url},body:JSON.stringify({cityId:cities[city],id:canonical.productId,limit:pageSize,page:index,sortOption:'PRICE'})});if(!response.ok)throw Error('Offers HTTP '+response.status);pages++;const raw=JSON.parse(await readLimited(response));const parsed=parsePublicPrices(raw,{...canonical,city,page:index,pageSize});assert.deepEqual(parsed.prices.map(x=>x.price),raw.offers.map((o:{price:number})=>Number(o.price)));return parsed;},{pageSize,maxPages:pagination?20:6});
 const values=book.prices.map(p=>p.price).sort((a,b)=>a-b);let independent=null;if(book.complete&&values.length){const n=values.length;independent={count:n,minimum:values[0],median:n%2?values[(n-1)/2]:(values[n/2-1]+values[n/2])/2,maximum:values[n-1]};assert.deepEqual(book.statistics,independent);}else assert.equal(book.statistics,null);
 const row={...sample,city,started,finished:new Date().toISOString(),productId:product.productId,name:product.name,attributeCount:product.attributes.length,pages,total:book.total,received:book.receivedCount,complete:book.complete,statistics:book.statistics,independentStatisticsMatch:book.complete,issue:book.issue,amounts:values};cases.push(row);console.log(JSON.stringify({product:sample.label,city,complete:book.complete,total:book.total,received:book.receivedCount,statistics:book.statistics,issue:book.issue}));if(!book.complete)failures++;
 }catch(e){failures++;cases.push({label:sample.label,url:sample.url,city,started,error:e instanceof Error?e.message:'failed'});console.log(JSON.stringify({product:sample.label,city,error:e instanceof Error?e.message:'failed'}));}}
}
await mkdir('docs/qa',{recursive:true});await writeFile(pagination?'docs/qa/kaspi-pagination.json':extra?'docs/qa/kaspi-extra.json':'docs/qa/kaspi-live.json',JSON.stringify({checkedAt:new Date().toISOString(),scope:pagination?'One known product, QA upstream page size 2; production uses 20. Raw amounts checked against parsed values.':extra?'2 extra products, Алматы, max 6 pages':'6 cases, 3 categories, 2 cities; max 6 pages per case; only public product data and anonymous prices',limitations:'Sequential source snapshot; not atomic. API prices checked against independent arithmetic, not confirmed checkout totals or seller-account data.',failures,cases},null,2));console.log('Saved sanitized Kaspi QA report');process.exitCode=failures?1:0;
